# EEI Power Supply UNIMAG Interface
# Provides simplified current control with automatic polarity and sequencing
# Requires eei_ps.template to be loaded
# Logic implemented in unimagControl.st (SNL state program)

################### UNIMAG Current Setpoint ####################
# User sets current in A (positive or negative)
# PV format: $(P):CURRENT_SP
# Monitored by SNL program for automatic sequencing. Soft record (no hardware
# link) - unimagEEIControl.st reads the sign/magnitude and writes the magnitude
# to $(P):CURR_SET_RAW after handling polarity switching.
record(ao, "$(P):CURRENT_SP")
{
    field(DESC, "Current Setpoint (signed)")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "0.001")
    field(PINI, "YES")
    field(DRVH, "$(MAX_CURR=330)")
    field(DRVL, "$(MIN_CURR=-330)")
    field(HOPR, "$(MAX_CURR=330)")
    field(LOPR, "$(MIN_CURR=-330)")
}

# EEI units can run in "Software" mode (register writes take effect
# immediately) or "Triggered" mode (a pending write - including a polarity
# change - only applies once CMD_START_RAMP is pulsed). Toggle live at
# runtime (no IOC restart) via caput - unimagEEIControl.st monitors this and
# adjusts its sequencing accordingly. Default is Software mode (matches how
# most EEI units behave); override the boot default with SW_MODE=0 on the
# dbLoadRecords macro line for units that need to start in Triggered mode.
record(bo, "$(P):MODE_SW_ENABLE")
{
    field(DESC, "Enable Software Mode (vs Triggered)")
    field(ZNAM, "Triggered")
    field(ONAM, "Software")
    field(PINI, "YES")
    field(VAL,  "$(SW_MODE=1)")
    field(FLNK, "$(P):MODE_APPLY")
}

# Applies the selected mode to the hardware mode-select bits
record(seq, "$(P):MODE_APPLY")
{
    field(DESC, "Apply Mode Selection to Hardware")
    field(SELM, "Specified")
    field(SELL, "$(P):MODE_SW_ENABLE NPP MS")
    field(DOL0, "1")
    field(LNK0, "$(P):CMD_CURRENT_MODE_TRIG PP")
    field(DOL1, "1")
    field(LNK1, "$(P):CMD_CURRENT_MODE_SW PP")
}

# Per the EEI regulator firmware docs, two different converter topologies
# exist in this family: quadrupole/normal-dipole regulators switch polarity
# with physical contactors (CMD_POLARITY_POS/NEG_EXEC + CMD_CONTACTORS_OPEN,
# confirmed via STAT_POLARITY_POS/NEG), while the pulsed-dipole H-bridge
# regulator has no such contactors - it reverses current electronically via
# a sign bit on the current reference (CURRENT_SP_SIGN) committed by the
# same START_RAMP/TRIGGER bit. STAT_POLARITY_POS/NEG reflect the (absent)
# contactor and can't be used to confirm polarity on this topology.
# Set POLARITY_VIA_SIGN=1 on the dbLoadRecords macro line for pulsed-dipole
# units (e.g. DHPTB102); default 0 (contactor-based) for everything else.
record(bo, "$(P):CFG_POLARITY_VIA_SIGN")
{
    field(DESC, "Polarity via sign bit, not contactors")
    field(ZNAM, "Contactors")
    field(ONAM, "Sign Bit")
    field(VAL,  "$(POLARITY_VIA_SIGN=0)")
}

################### Signed Current Readback ####################
# User-facing readback, matches $(P):CURRENT_SP's naming (see
# eei_ps.template for $(P):CURR_RB_RAW, register 40025).
#
# CURR_RB_RAW is already genuinely signed on BOTH topologies - asyn
# sign-extends the 16-bit register correctly, and it directly reflects the
# real measured current's sign - so it's passed straight through here.
# $(P):CURRENT_RB_SIGN (register 40026) is NOT reliably populated on real
# hardware on either topology: it reads a fixed raw 0xFFFF ("Illegal
# Value") regardless of actual polarity. This was confirmed with repeated
# stable reads several seconds apart on both QUATB201 and DHPTB102, *after*
# fixing the write-side 32-bit-reference bug on DHPTB102 (see CURR_SET_RAW
# in eei_ps.template) - before that fix, an earlier reading that looked
# like a reliable CURRENT_RB_SIGN was actually an artifact of the firmware
# being in a confused state from the malformed setpoint, not a real signal.
record(calc, "$(P):CURRENT_RB")
{
    field(DESC, "Current Readback (signed)")
    field(INPA, "$(P):CURR_RB_RAW CP")
    field(CALC, "A")
    field(EGU,  "A")
    field(PREC, "3")
}

################### Sequencing tolerances and failure flags ####################
# Used by unimagEEIControl.st. Exact zero / exact setpoint are never reached
# on real hardware (sensor noise, regulator dead-band), so every wait is
# judged against a tolerance and bounded by a timeout instead.
#   ZERO_TOLERANCE  - |readback| at or below this is "zero" (before standby /
#                     polarity change)
#   SET_TOLERANCE   - readback within this of the request is "reached"
#                     (0 disables the check)
#   SET_TIMEOUT_S   - how long each wait may last before it is reported failed
record(ao, "$(P):ZERO_TOLERANCE")
{
    field(DESC, "Current considered zero")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(ZERO_TOLERANCE=2)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "100")
    field(HOPR, "100")
    field(LOPR, "0")
}

record(ao, "$(P):SET_TOLERANCE")
{
    field(DESC, "Setpoint reached tolerance")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(SET_TOLERANCE=1)")
    field(PINI, "YES")
    field(DRVL, "0")
    field(DRVH, "100")
    field(HOPR, "100")
    field(LOPR, "0")
}

record(ao, "$(P):SET_TIMEOUT_S")
{
    field(DESC, "Zero/state/setpoint wait timeout")
    field(EGU,  "s")
    field(PREC, "1")
    field(VAL,  "$(SET_TIMEOUT_S=30)")
    field(PINI, "YES")
    field(DRVL, "1")
    field(DRVH, "300")
    field(HOPR, "300")
    field(LOPR, "1")
}

# Set by unimagEEIControl.st, cleared by the next setpoint or CMD_RESET
record(bo, "$(P):SP_NOT_REACHED")
{
    field(DESC, "Setpoint not reached in time")
    field(ZNAM, "OK")
    field(ONAM, "Not Reached")
}

record(bo, "$(P):ST_NOT_REACHED")
{
    field(DESC, "Zero/standby/polarity/power not reached")
    field(ZNAM, "OK")
    field(ONAM, "Not Reached")
}

# Overall status readback - decode state from individual bits
# PV format: $(P):STATE_RB
# Values: 0=OFF, 1=ON, 2=STANDBY, 3=FAULT, 4=EXT_INTLK,
#         5=CONN_FAULT, 6=SP_NOT_REACHED, 7=ST_NOT_REACHED
# Priority: CONN_FAULT > EXT_INTLK > FAULT > ST_NOT_REACHED >
#           SP_NOT_REACHED > ON > STANDBY > OFF
record(calcout, "$(P):STATE_DECODE")
{
    field(DESC, "Decode Power Supply State")
    field(INPA, "$(P):STAT_STANDBY CP")
    field(INPB, "$(P):STAT_POWER_ON CP")
    field(INPC, "$(P):STAT_FAULTY CP")
    # STAT_WORD1_RB has no configured value alarms, so a non-zero SEVR means
    # its Modbus/asyn read failed.  Checking SEVR keeps a valid all-zero status
    # word available for OFF instead of confusing it with a connection fault.
    # Magnet interlock faults are reported as a distinct state instead of the
    # generic power-supply fault.
    field(INPD, "$(P):STAT_WORD1_RB.SEVR CP NMS")
    field(INPE, "$(P):FAULT_PLC_MAG_ILK1 CP NMS")
    field(INPF, "$(P):FAULT_PLC_MAG_ILK2 CP NMS")
    # A failed sequencing step or an unreached setpoint (see the tolerance
    # section above) only shows when nothing more serious is active.
    field(INPG, "$(P):ST_NOT_REACHED CP NMS")
    field(INPH, "$(P):SP_NOT_REACHED CP NMS")
    field(CALC, "D?5:((E||F)?4:(C?3:(G?7:(H?6:(B?1:(A?2:0))))))")
    field(OUT,  "$(P):STATE_RB PP")
}

record(mbbi, "$(P):STATE_RB")
{
    field(DESC, "Power Supply State")
    field(INP,  "$(P):STATE_DECODE NPP")
    field(ZRST, "OFF")
    field(ONST, "ON")
    field(TWST, "STANDBY")
    field(THST, "FAULT")
    field(FRST, "EXT_INTLK")
    field(FVST, "CONN_FAULT")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(THVL, "3")
    field(FRVL, "4")
    field(FVVL, "5")
    field(SXST, "SP_NOT_REACHED")
    field(SXVL, "6")
    field(SVST, "ST_NOT_REACHED")
    field(SVVL, "7")
    field(ZRSV, "NO_ALARM")
    field(ONSV, "NO_ALARM")
    field(TWSV, "NO_ALARM")
    field(THSV, "MAJOR")
    field(FRSV, "MAJOR")
    field(FVSV, "MAJOR")
    field(SXSV, "MINOR")
    field(SVSV, "MAJOR")
}

# State control setpoint
# PV format: $(P):STATE_SP
# Allows user to command state changes: STANDBY, ON, RESET, OFF
record(mbbo, "$(P):STATE_SP")
{
    field(DESC, "Set Power Supply State")
    field(ZRST, "OFF")
    field(ONST, "ON")
    field(TWST, "STANDBY")
    field(THST, "RESET")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(THVL, "3")
    field(FLNK, "$(P):STATE_PROCESS")
}

# Process state change requests
record(seq, "$(P):STATE_PROCESS")
{
    field(DESC, "Process State Command")
    field(SELM, "Specified")
    field(SELL, "$(P):STATE_SP NPP MS")
    # Link 0: OFF command → go to STANDBY
    field(DOL0, "1")
    field(LNK0, "$(P):CMD_STANDBY PP")
    # Link 1: ON command
    field(DOL1, "1")
    field(LNK1, "$(P):CMD_POWER_ON PP")

    # Link 2: STANDBY command
    field(DOL2, "1")
    field(LNK2, "$(P):CMD_STANDBY PP")

    # Link 3: RESET command
    field(DOL3, "1")
    field(LNK3, "$(P):CMD_RESET PP")
}

# Interlock status
record(calc, "$(P):INTERLOCKED")
{
    field(DESC, "Interlock Active")
    field(INPA, "$(P):STAT_FAULTY CP")
    field(CALC, "A")
}
